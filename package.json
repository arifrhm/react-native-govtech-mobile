{
  "name": "react-native-govtech-mobile",
  "version": "1.0.0",
  "description": "Cross-Platform React Native & Expo Mobile Application for Public Sector Workforce & Citizen Services — TypeScript, Clean Architecture, Offline-First SQLite, Biometric Auth, Geofencing & Automated CI/CD",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx"
  },
  "keywords": [
    "react-native",
    "expo",
    "typescript",
    "clean-architecture",
    "offline-first",
    "biometrics",
    "geofencing",
    "govtech",
    "enterprise"
  ],
  "author": "Arif Rahman <arif.rahman.rhm@gmail.com> (https://arifrahman.biz.id)",
  "license": "MIT",
  "dependencies": {
    "@react-native-async-storage/async-storage": "^1.23.1",
    "@react-navigation/bottom-tabs": "^6.5.20",
    "@react-navigation/native": "^6.1.17",
    "@react-navigation/native-stack": "^6.9.26",
    "@tanstack/react-query": "^5.28.9",
    "axios": "^1.6.8",
    "expo": "~51.0.0",
    "expo-constants": "~16.0.1",
    "expo-crypto": "~13.0.2",
    "expo-local-authentication": "~14.0.1",
    "expo-location": "~17.0.1",
    "expo-secure-store": "~13.0.2",
    "expo-status-bar": "~1.12.1",
    "react": "18.2.0",
    "react-native": "0.74.1",
    "react-native-safe-area-context": "4.10.1",
    "react-native-screens": "3.31.1"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@types/jest": "^29.5.12",
    "@types/react": "~18.2.79",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "typescript": "~5.3.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ],
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json"
    ]
  }
}
